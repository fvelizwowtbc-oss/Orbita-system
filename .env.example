# .env.example
# Copia este archivo como .env y ajusta los valores.
# En modo .exe, el .env se busca en %APPDATA%\SistemaGestion\.env

# ============ SEGURIDAD ============
SECRET_KEY=cambiar-esta-clave-en-produccion-por-una-aleatoria-larga

# ============ BASE DE DATOS ============
# (SQLite se configura automaticamente en instance/)

# ============ ARCHIVOS ============
MAX_CONTENT_LENGTH=16777216

# ============ TASAS ============
TASA_CACHE_TTL=3600
TASA_FALLBACK=50.0

# ============ ZONA HORARIA ============
TIMEZONE=America/Caracas
